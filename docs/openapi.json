  "paths": {
    "/health": {
      "get": {
        "description": "Report service readiness without exposing sensitive configuration.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/athletes/me": {
      "delete": {
        "operationId": "erase_me_v1_athletes_me_delete",
        "parameters": [
          {
            "in": "query",
            "name": "confirm",
            "required": false,
            "schema": {
              "default": false,
              "title": "Confirm",
              "type": "boolean"
            }
          },
          {
            "in": "header",
            "name": "x-athlete-id",
            "required": false,
            "schema": {
              "default": "me",
              "pattern": "^[A-Za-z0-9_-]{1,40}$",
              "title": "X-Athlete-Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Erase Me V1 Athletes Me Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Erase Me"
      },
      "get": {
        "operationId": "get_me_v1_athletes_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-athlete-id",
            "required": false,
            "schema": {
