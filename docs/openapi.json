                "schema": {
                  "$ref": "#/components/schemas/AthleteOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Me"
      },
      "put": {
        "operationId": "put_me_v1_athletes_me_put",
        "parameters": [
          {
            "in": "header",
            "name": "x-athlete-id",
            "required": false,
            "schema": {
              "default": "me",
              "pattern": "^[A-Za-z0-9_-]{1,40}$",
              "title": "X-Athlete-Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AthleteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
