{
  "name": "jimbro-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "train:uiprmd": "rolldown ../ml/uiprmd/train.ts --platform node --format esm -o ../ml/data/build/train.mjs && node ../ml/data/build/train.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.1.10"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
