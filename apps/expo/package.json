{
  "name": "jimbro",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test src/lib/*.test.js",
    "harness": "node scripts/engine-harness.mjs",
    "test:ui": "npm run test:chat",
    "test:e2e": "expo export --platform web --output-dir dist-web && playwright test",
    "test:e2e:only": "playwright test",
    "test:chat": "node scripts/test-chat.mjs",
    "preview:review": "expo start --web --port 8081"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "puppeteer-core": "^24.43.1"
  }
}
