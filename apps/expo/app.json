{
  "expo": {
    "name": "JimBro",
    "slug": "jimbro",
    "scheme": "jimbro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101310"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "JimBro uses the camera to count your reps from your pose. Video stays on your phone and is never saved or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "jimProxyUrl": "",
      "eas": {
        "projectId": "88d6298a-9d41-4f4a-a6e6-41c90e8cf6d9"
      }
    },
    "owner": "slaterr",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/88d6298a-9d41-4f4a-a6e6-41c90e8cf6d9"
    }
  }
}
