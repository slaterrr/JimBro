# Copy to .env (git-ignored) and fill in. Never commit .env or paste keys in chat.
ANTHROPIC_API_KEY=sk-ant-...
# Shared secret the app must send as X-Jim-Key (any long random string; same value in the app's .env)
JIM_PROXY_KEY=change-me-to-a-long-random-string
# Optional
# JIM_MODEL=claude-sonnet-5-5
# JIM_FALLBACKS=0
# PORT=8787
