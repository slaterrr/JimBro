[Unit]
Description=JimBro API and PWA (HTTPS + LAN HTTP for Expo Go)
After=network-online.target
Wants=network-online.target

[Service]
User=jimbro
Group=jimbro
EnvironmentFile=/etc/jimbro/jimbro.env
WorkingDirectory=/opt/jimbro/app
# One process serves HTTPS (browser PWA) and LAN HTTP (Expo Go) so both share live events.
ExecStart=/usr/bin/env PYTHONPATH=/opt/jimbro/app/backend /opt/jimbro/venv/bin/python -m jimbro.serve
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@DATA_DIR@
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
