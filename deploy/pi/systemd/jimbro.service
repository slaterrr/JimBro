[Unit]
Description=JimBro API and PWA
After=network-online.target
Wants=network-online.target

[Service]
User=jimbro
Group=jimbro
EnvironmentFile=/etc/jimbro/jimbro.env
WorkingDirectory=/opt/jimbro/app
ExecStart=/opt/jimbro/venv/bin/python -m uvicorn jimbro.api:app --app-dir backend \
  --host 0.0.0.0 --port ${JIMBRO_PORT} \
  --ssl-keyfile /etc/jimbro/tls.key --ssl-certfile /etc/jimbro/tls.crt \
  --ws-ping-interval 20 --no-server-header
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@DATA_DIR@
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
