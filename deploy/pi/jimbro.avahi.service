<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertise JimBro on the LAN so phones/laptops can discover it without an IP. -->
<service-group>
  <name replace-wildcards="yes">JimBro on %h</name>
  <service>
    <type>_https._tcp</type>
    <port>@PORT@</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
